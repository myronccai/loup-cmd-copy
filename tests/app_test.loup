@mode(host.dual)

# Exit statuses of the whole command line. These tests print the program's
# normal output and error messages.

from debug.assert import (expect, expectEq);
from io.fs import (createDir, writeText, removeDir, isDir, isFile);
from appinfo import (EXIT_OK, EXIT_FAILURE);
from cli.app import (run);

func test_version_succeeds(): void {
    expectEq(run(["--version"]), EXIT_OK, "--version");
}

func test_help_succeeds(): void {
    expectEq(run(["/?"]), EXIT_OK, "/?");
}

func test_usage_error_fails(): void {
    let none: list[string] = [];
    expectEq(run(none), EXIT_FAILURE, "no source");
}

func test_copy(): void {
    let root = "build/tmp/app_copy";
    if (isDir(root)) {
        removeDir(root);
    }
    createDir(root);
    writeText(root + "/t.txt", "tests pass\n");
    expectEq(run([root + "\\t.txt", root + "\\u.txt"]), EXIT_OK, "copied");
    expect(isFile(root + "/u.txt"), "the copy");
    expectEq(run([root + "/none.txt", root + "/v.txt"]), EXIT_FAILURE, "missing source");
    removeDir(root);
}
