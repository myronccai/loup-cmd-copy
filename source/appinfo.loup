@mode(host.dual)

# Application identity. Keep APP_NAME and APP_VERSION in step with `name`
# and `version` in package.lppkg.

pub const APP_NAME: string = "copy";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "Copy and combine files (a Loup recreation of the Windows copy command).";

# Exit statuses returned by main(). Like cmd.exe's copy, a usage error is
# ERRORLEVEL 1, the same as a file that could not be copied.
pub const EXIT_OK: int = 0;
pub const EXIT_FAILURE: int = 1;
