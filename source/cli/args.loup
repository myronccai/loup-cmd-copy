@mode(host.dual)

# Command-line parsing for copy. The shared Windows switch parser
# (win/switches.loup) recognises the switches; this module adds what is
# special about copy: `+` joins sources (`a+b`, `a + b`), and /A and /B are
# positional: they apply to the file just before them and to every file after
# them, until the next /A or /B.
#
# Runtime: host.dual. Compiled into the native binary build/copy by
# `make build`; `make run` (Stage0's `loup-bootstrap run`) interprets the same
# code.
#
# Structure: parse_switches() finds a help or version request. parse_args()
# then walks argv itself, in two passes: first into a stream of names and `+`
# signs, each name with the mode in force, then reading that stream as
# `source (+ source)* [destination]`. copycmd_confirm() and should_ask()
# decide whether to ask before overwriting.

from win.messages import (MSG_SYNTAX);
from win.switches import (SwitchSpec, flag, parse_switches, switch_error_message);

# How a file is read or written: /A (text: a source ends at its first
# Ctrl-Z, a destination gets one at the end), /B (bytes as they are), or
# not said (copy decides: /A when combining files, else /B).
pub const MODE_DEFAULT: int = 0;
pub const MODE_ASCII: int = 1;
pub const MODE_BINARY: int = 2;

# Whether to ask before overwriting: not said, /-Y, /Y.
pub const CONFIRM_DEFAULT: int = 0;
pub const CONFIRM_ASK: int = 1;
pub const CONFIRM_NEVER: int = 2;

# A source or destination as typed, with its /A or /B mode.
pub struct FileArg {
    pub name: string;
    pub mode: int;
}

pub func make_file_arg(name: string, mode: int): FileArg {
    return FileArg(name = name, mode = mode);
}

pub struct Options {
    pub help: bool;
    pub version: bool;
    pub confirm: int;
    pub verify: bool;              # /V
    pub sources: list[FileArg];
    pub has_dest: bool;
    pub dest: FileArg;
    pub joined: bool;              # sources were joined with `+`
}

# /D, /N, /Z and /L are accepted and have no effect (see the README).
pub func copy_switches(): list[SwitchSpec] {
    return [flag("A"), flag("B"), flag("V"), flag("Y"), flag("-Y"), flag("D"), flag("N"),
        flag("Z"), flag("L")];
}

func empty_options(help: bool, version: bool): Options {
    let none: list[FileArg] = [];
    return Options(help = help, version = version, confirm = CONFIRM_DEFAULT, verify = false,
        sources = none, has_dest = false, dest = make_file_arg("", MODE_DEFAULT), joined = false);
}

# The switches one argument holds (`/A`, `/Y/V`), or [] for an operand.
func switch_names(token: string): list[string] {
    var names: list[string] = [];
    if (token == "--help" or token == "--version") {
        return names;
    }
    match parse_switches([token], copy_switches()) {
        Ok(p) => {
            for (sw in p.switches) {
                names.push(sw.name);
            }
        },
        Err(e) => {},
    }
    return names;
}

const SYM_NAME: int = 0;
const SYM_PLUS: int = 1;

pub func parse_args(argv: list[string]): Result[Options, string] {
    let parsed = match parse_switches(argv, copy_switches()) {
        Ok(p) => p,
        Err(e) => {
            return Err(switch_error_message(e));
        },
    };
    if (parsed.help or parsed.version) {
        return Ok(empty_options(parsed.help, parsed.version));
    }

    # The operands as a stream of names and `+`, each name with its mode.
    var kinds: list[int] = [];
    var texts: list[string] = [];
    var modes: list[int] = [];
    var confirm = CONFIRM_DEFAULT;
    var verify = false;
    var mode = MODE_DEFAULT;
    var after_name = false;
    var ended = false;
    for (token in argv) {
        if (!ended and token == "--") {
            ended = true;
            after_name = false;
            continue;
        }
        var names: list[string] = [];
        if (!ended) {
            names = switch_names(token);
        }
        if (names.len() > 0) {
            for (name in names) {
                if (name == "A" or name == "B") {
                    # The new mode holds from here on, and also for the
                    # name just before the switch (`a.txt /B`).
                    mode = if (name == "A") { MODE_ASCII } else { MODE_BINARY };
                    if (after_name) {
                        modes[modes.len() - 1] = mode;
                    }
                } else if (name == "Y") {
                    confirm = CONFIRM_NEVER;
                } else if (name == "-Y") {
                    confirm = CONFIRM_ASK;
                } else if (name == "V") {
                    verify = true;
                }
            }
            continue;
        }
        let pieces = token.split("+");
        for (i in 0..pieces.len()) {
            if (i > 0) {
                kinds.push(SYM_PLUS);
                texts.push("");
                modes.push(mode);
                after_name = false;
            }
            if (pieces[i].len() > 0) {
                kinds.push(SYM_NAME);
                texts.push(pieces[i]);
                modes.push(mode);
                after_name = true;
            }
        }
    }

    # sources: NAME (+ NAME)*, then an optional destination NAME.
    let n = kinds.len();
    if (n == 0 or kinds[0] != SYM_NAME) {
        return Err(MSG_SYNTAX);
    }
    var sources: list[FileArg] = [make_file_arg(texts[0], modes[0])];
    var joined = false;
    var i = 1;
    while (i < n and kinds[i] == SYM_PLUS) {
        joined = true;
        while (i < n and kinds[i] == SYM_PLUS) {
            i += 1;
        }
        if (i < n) {
            sources.push(make_file_arg(texts[i], modes[i]));
            i += 1;
        }
    }
    var has_dest = false;
    var dest = make_file_arg("", MODE_DEFAULT);
    if (i < n) {
        has_dest = true;
        dest = make_file_arg(texts[i], modes[i]);
        i += 1;
    }
    if (i < n) {
        return Err(MSG_SYNTAX);
    }
    return Ok(Options(help = false, version = false, confirm = confirm, verify = verify,
        sources = sources, has_dest = has_dest, dest = dest, joined = joined));
}

# The confirm setting of a COPYCMD value such as "/Y" or "/-y".
pub func copycmd_confirm(value: string): int {
    var confirm = CONFIRM_DEFAULT;
    for (word in value.split(" ")) {
        let w = word.trim().toUpperCase();
        if (w == "/Y" or w == "-Y") {
            confirm = CONFIRM_NEVER;
        } else if (w == "/-Y" or w == "--Y") {
            confirm = CONFIRM_ASK;
        }
    }
    return confirm;
}

# Whether to ask before overwriting: the command line wins, then COPYCMD;
# by default copy asks, as it does at the cmd prompt.
pub func should_ask(confirm: int, copycmd: string): bool {
    if (confirm != CONFIRM_DEFAULT) {
        return confirm == CONFIRM_ASK;
    }
    return copycmd_confirm(copycmd) != CONFIRM_NEVER;
}
