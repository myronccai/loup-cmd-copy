@mode(host.dual)

# Help and version text of copy: what `copy /?` prints (a short summary of
# this recreation's syntax and switches) and the series' `--version` line.
#
# Runtime: host.dual. Compiled into the native binary build/copy by
# `make build`; `loup run source/main.loup` interprets the same code.

from appinfo import (APP_NAME, APP_VERSION);

# The text of `copy /?`: a short summary of this recreation's syntax and
# switches.
pub func usage(): string {
    let lines = [
        "Copy files, or combine several files into one.",
        "",
        "COPY [/V] [/Y | /-Y] [/A | /B] source [/A | /B] [+ source [/A | /B] ...]",
        "     [destination [/A | /B]]",
        "",
        "  source       A file, a pattern with * and ?, or a directory (its files).",
        "               Join sources with + to combine them into one file.",
        "  destination  A directory, a file name, or a pattern such as *.bak.",
        "               Without it, files go to the current directory (joined",
        "               sources are appended to the first one).",
        "  /A           Text: a source ends at its first Ctrl-Z, and the",
        "               destination gets one at the end (the default when combining).",
        "  /B           Binary: bytes as they are (the default for a plain copy).",
        "  /V           Check each new file against its sources.",
        "  /Y, /-Y      Replace existing files without asking, or ask first.",
        "               Without either, copy asks unless COPYCMD contains /Y.",
        "  /D /N /Z /L  Accepted for compatibility; they change nothing.",
    ];
    return lines.join("\n");
}

pub func version_line(): string {
    return i"{$ APP_NAME $} (loup-cmd-{$ APP_NAME $}) {$ APP_VERSION $}";
}
