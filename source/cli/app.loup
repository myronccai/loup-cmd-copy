@mode(host.dual)

from appinfo import (EXIT_OK, EXIT_FAILURE);
from cli.args import (parse_args);
from cli.usage import (usage, version_line);
from commands.copy import (run_copy);

# Parses argv, runs copy and returns the exit status (cmd's ERRORLEVEL).
pub func run(argv: list[string]): int {
    let opts = match parse_args(argv) {
        Ok(parsed) => parsed,
        Err(msg) => {
            printErr(msg);
            return EXIT_FAILURE;
        },
    };

    if (opts.help) {
        println(usage());
        return EXIT_OK;
    }
    if (opts.version) {
        println(version_line());
        return EXIT_OK;
    }

    try {
        return run_copy(opts);
    } catch (Exception as e) {
        printErr(e.message);
        return EXIT_FAILURE;
    }
}
