@mode(host.dual)

# The `Overwrite X? (Yes/No/All):` question. Loup 1.26.0 can only read
# standard input whole, so each answer is read by a `sh` child that inherits
# standard input: its `read` takes one line and nothing more, from a pipe or
# from the terminal.

pub const ANSWER_YES: int = 1;
pub const ANSWER_NO: int = 2;
pub const ANSWER_ALL: int = 3;
pub const ANSWER_INVALID: int = 0;
pub const ANSWER_EOF: int = -1;

# One line of standard input without its newline, or None at the end.
pub func read_line(): Option[string] {
    let r = exec(["sh", "-c", "IFS= read -r line; rc=$?; printf '%s' \"$line\"; exit $rc"]);
    let text = r.stdout.to_string();
    if (r.exit_code != 0 and text.len() == 0) {
        return None;
    }
    return Some(text);
}

# Whether standard input is a terminal (which then echoes the answer).
pub func stdin_is_terminal(): bool {
    let r = exec(["test", "-t", "0"]);
    return r.exit_code == 0;
}

# What an answer means: its first non-blank character, Y, N or A in any
# case. Anything else asks again.
pub func parse_answer(text: string): int {
    let t = text.trim().toUpperCase();
    if (t.startsWith("Y")) {
        return ANSWER_YES;
    }
    if (t.startsWith("N")) {
        return ANSWER_NO;
    }
    if (t.startsWith("A")) {
        return ANSWER_ALL;
    }
    return ANSWER_INVALID;
}

# The question for a destination already in Windows form.
pub func overwrite_question(display: string): string {
    return "Overwrite " + display + "? (Yes/No/All): ";
}

# Asks until the answer is Yes, No or All; the end of input counts as No.
# When standard input is not a terminal, the answer is echoed so that the
# output reads as it would on screen.
pub func ask_overwrite(display: string): int {
    let echo_answer = !stdin_is_terminal();
    while (true) {
        print(overwrite_question(display));
        var text = "";
        var at_end = false;
        match read_line() {
            Some(line) => {
                text = line;
            },
            None => {
                at_end = true;
            },
        }
        if (at_end) {
            if (echo_answer) {
                println("");
            }
            return ANSWER_EOF;
        }
        if (echo_answer) {
            println(text);
        }
        let answer = parse_answer(text);
        if (answer != ANSWER_INVALID) {
            return answer;
        }
    }
    return ANSWER_NO;
}
